# task-manager — приклад конфігу. Скопіюй у .env (gitignored) і заповни.
# На сервері цей файл — /etc/task-manager/env (root 0600, читає systemd; правити — sudoedit).
# ⚠️ Секрети генеруєш/вводиш ТИ САМ (rules §8). Тут — лише плейсхолдери.
# Лише KEY=value, коментарі — окремим рядком: systemd EnvironmentFile не відкидає «  # …» у кінці рядка.

# --- Домен задач -------------------------------------------------------------
# Корінь planner; локально: ~/planner; на сервері — /srv/planner (задає конфіг інстансу).
TASKS_PLANNER_ROOT=~/planner
# Ліміт задач у in_progress.
TASKS_WIP_LIMIT=15
# Каталог стану: OAuth-клієнти й токени → $TASKS_STATE_DIR/oauth_state.json (0600).
# Порожньо = .oauth_state.json поруч із кодом (локальна розробка). На сервері задає юніт: /var/lib/task-manager.
# TASKS_STATE_DIR=

# --- Bearer-інстанс (tailnet, :8792, для Mac) --------------------------------
# Згенеруй сам, напр.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TASKS_TOKEN=
# Опційний другий, обмежений bearer для раннера `elf` (генеруєш сам, як TASKS_TOKEN).
# Порожньо/не задано = доступу для elf нема. Токен приймається лише з loopback (127.0.0.1, ::1);
# дозволені тули: усі elf_*, list_tasks, get_task, board; дашборд і решта тулів → 403.
# Зміни під ним у журналі з клієнтом `elf`.
TASKS_ELF_TOKEN=

# --- OAuth-інстанс (публічний за Caddy/Funnel, :8793: Claude-конектор + ChatGPT app)
TASKS_ISSUER_URL=https://your-host.example.ts.net/tasks
# Resource для привʼязки токенів (RFC 8707). Порожньо = issuer (коли той закінчується на /tasks).
# TASKS_RESOURCE_URL=https://your-host.example.ts.net/tasks
# Пароль НЕ пиши сюди у відкритому вигляді — згенеруй хеш:
#   (у теці репо) python3 -c "from getpass import getpass; from tasks_oauth import hash_password; print(hash_password(getpass()))"
# Вивід — рядок pbkdf2_sha256$iters$salt_hex$hash_hex; встав його нижче.
TASKS_OAUTH_PASSWORD_HASH=

# ⚠️ ОБОВʼЯЗКОВО для OAuth-інстансу: без цього MCP-запит з-за Funnel відбивається
# 421 Misdirected Request ("Invalid Host header"), і клієнт зациклюється на логіні.
# Це DNS-rebinding guard MCP SDK: Host має бути в білому списку.
# (bearer-інстанс свій список отримує з systemd-юніта, тут його дублювати не треба)
TASKS_ALLOWED_HOSTS=your-host.example.ts.net

# Мітка клієнта в журналі змін (mac | phone | local). Для інстансів на сервері
# задається в systemd-юнітах, тут потрібна лише для локального запуску.
# TASKS_CLIENT=local

# --- Опційно -----------------------------------------------------------------
# TASKS_HTTP_PATH=/tasks                   # шлях MCP-ендпоінта (Caddy роутить сюди)
# TASKS_ALLOWED_ORIGINS=
